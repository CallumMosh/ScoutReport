# ---- Required: Google Gemini (server-side only, never exposed to the browser) ----
# Get a free key at https://aistudio.google.com/apikey  (no credit card needed)
GEMINI_API_KEY=your-gemini-key-here

# Optional: override the model. Defaults to gemini-2.5-flash (free tier).
# GEMINI_MODEL=gemini-2.5-flash

# ---- Optional: Supabase (for a saved shelf that syncs across devices) ----
# Leave these blank to fall back to browser localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
